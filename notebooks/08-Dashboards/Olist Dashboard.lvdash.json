            "displayName": "Seller State"
          },
          {
            "name": "order_purchase_date_key",
            "expr": "source.order_purchase_date_key",
            "displayName": "Order Purchase Date Key"
          },
          {
            "name": "price",
            "expr": "source.price",
            "displayName": "Price"
          },
          {
            "name": "freight_value",
            "expr": "source.freight_value",
            "displayName": "Freight Value"
          },
          {
            "name": "total_price",
            "expr": "source.total_price",
            "displayName": "Total Price"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          },
          {
            "name": "total_revenue",
            "expr": "SUM(source.total_price)",
            "displayName": "Total Revenue"
          },
          {
            "name": "order_count",
            "expr": "COUNT(DISTINCT source.order_id)",
            "displayName": "Order Count"
          },
          {
            "name": "average_order_value",
            "expr": "MEASURE(total_revenue) / MEASURE(order_count)",
            "displayName": "Average Order Value"
          }
        ]
      }
    },
    {
      "name": "fc1e4e5e",
      "displayName": "vw_operations",
      "config": {
