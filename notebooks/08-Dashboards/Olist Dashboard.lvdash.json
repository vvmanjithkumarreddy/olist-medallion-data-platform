            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "delivery_metrics",
      "displayName": "Delivery Metrics",
      "config": {
        "version": "1.1",
        "source": "SELECT \n  fo.order_id,\n  fo.order_status,\n  fo.delivery_status,\n  fo.order_purchase_date_key,\n  foi.order_item_id,\n  foi.price,\n  foi.freight_value,\n  (foi.price + foi.freight_value) as item_total\nFROM olist_catalog.gold.fact_orders fo LEFT JOIN olist_catalog.gold.fact_order_items foi\n  ON fo.order_id = foi.order_id\n",
        "dimensions": [
          {
            "name": "order_id",
            "expr": "order_id",
            "displayName": "Order ID"
          },
          {
            "name": "order_status",
            "expr": "order_status",
            "displayName": "Order Status"
          },
          {
            "name": "delivery_status",
            "expr": "delivery_status",
            "displayName": "Delivery Status"
          },
          {
            "name": "order_purchase_date_key",
            "expr": "order_purchase_date_key",
            "displayName": "Order Purchase Date Key"
          },
          {
            "name": "order_item_id",
            "expr": "order_item_id",
            "displayName": "Order Item ID"
          }
        ],
        "measures": [
          {
            "name": "total_delivered_orders",
            "expr": "COUNT(DISTINCT CASE WHEN order_status = 'delivered' THEN order_id END)",
            "displayName": "Total Delivered Orders"
          },
          {
            "name": "ontime_delivered_orders",
            "expr": "COUNT(DISTINCT CASE WHEN order_status = 'delivered' AND delivery_status = 'on_time' THEN order_id END)",
            "displayName": "On-Time Delivered Orders"
          },
          {
            "name": "ontime_delivery_rate",
            "expr": "MEASURE(ontime_delivered_orders) * 100.0 / MEASURE(total_delivered_orders)",
            "displayName": "On-Time Delivery Rate"
          },
          {
            "name": "total_delivered_orders_value",
            "expr": "SUM(CASE WHEN order_status = 'delivered' THEN item_total END)",
            "displayName": "Total Delivered Orders Value"
          },
          {
            "name": "total_order_items_sold",
            "expr": "COUNT(CASE WHEN order_status = 'delivered' THEN order_item_id END)",
            "displayName": "Total Order Items Sold"
          },
          {
            "name": "total_order_items",
            "expr": "COUNT(order_item_id)",
            "displayName": "Total Order Items"
          }
        ]
      }
    },
    {
      "name": "customer_metrics",
      "displayName": "Customer Metrics",
      "config": {
        "version": "1.1",
        "source": "SELECT \n  fo.order_id,\n  dc.customer_unique_id,\n  dc.customer_state,\n  foi.price,\n  foi.freight_value,\n  (foi.price + foi.freight_value) as revenue\nFROM olist_catalog.gold.fact_orders fo JOIN olist_catalog.gold.dim_customers dc\n  ON fo.customer_sk = dc.customer_sk\nLEFT JOIN olist_catalog.gold.fact_order_items foi\n  ON fo.order_id = foi.order_id\n",
        "dimensions": [
          {
            "name": "order_id",
            "expr": "order_id",
            "displayName": "Order ID"
          },
          {
            "name": "customer_unique_id",
            "expr": "customer_unique_id",
            "displayName": "Customer Unique ID"
          },
          {
            "name": "customer_state",
            "expr": "customer_state",
            "displayName": "Customer State"
          }
        ],
        "measures": [
          {
            "name": "total_unique_customers",
            "expr": "COUNT(DISTINCT customer_unique_id)",
            "displayName": "Total Unique Customers"
          },
          {
            "name": "total_orders",
            "expr": "COUNT(DISTINCT order_id)",
            "displayName": "Total Orders"
          },
          {
            "name": "avg_orders_per_customer",
            "expr": "MEASURE(total_orders) * 1.0 / MEASURE(total_unique_customers)",
            "displayName": "Average Orders Per Customer"
          },
          {
            "name": "total_revenue",
            "expr": "SUM(revenue)",
            "displayName": "Total Revenue"
          }
        ]
      }
    },
    {
      "name": "monthly_revenue",
      "displayName": "Monthly Revenue Trend",
      "config": {
        "version": "1.1",
        "source": "SELECT \n  dd.full_date,\n  dd.year,\n  dd.month,\n  dd.month_name,\n  fo.order_id,\n  foi.price,\n  foi.freight_value,\n  (foi.price + foi.freight_value) as revenue\nFROM olist_catalog.gold.fact_orders fo JOIN olist_catalog.gold.dim_date dd\n  ON fo.order_purchase_date_key = dd.date_key\nLEFT JOIN olist_catalog.gold.fact_order_items foi\n  ON fo.order_id = foi.order_id\n",
        "dimensions": [
          {
            "name": "full_date",
            "expr": "full_date",
            "displayName": "Full Date"
          },
          {
            "name": "year",
            "expr": "year",
            "displayName": "Year"
          },
          {
            "name": "month",
            "expr": "month",
            "displayName": "Month"
          },
          {
            "name": "month_name",
            "expr": "month_name",
            "displayName": "Month Name"
          },
          {
            "name": "year_month",
            "expr": "CONCAT(CAST(year AS STRING), '-', LPAD(CAST(month AS STRING), 2, '0'))",
            "displayName": "Year-Month"
          },
          {
            "name": "month_year_display",
            "expr": "CONCAT(month_name, ' ', CAST(year AS STRING))",
            "displayName": "Month Year Display"
          },
          {
            "name": "short_month_year",
            "expr": "CONCAT(SUBSTRING(month_name, 1, 3), ' ', CAST(year AS STRING))",
            "displayName": "Short Month Year"
          }
        ],
        "measures": [
          {
            "name": "total_revenue",
            "expr": "SUM(revenue)",
            "displayName": "Total Revenue"
          }
        ]
      }
    }
  ],
